<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToDo アプリ</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="container">
    <h1>ToDo アプリ</h1>

    <form class="add-form" method="post" action="/todos">
      <input type="text" name="title" placeholder="新しい ToDo を入力" disabled>
      <button type="submit" disabled>追加</button>
    </form>

    <ul class="todo-list">
      <% todos.forEach((todo) => { %>
        <li class="todo-item <%= todo.done ? 'done' : '' %>">
          <input type="checkbox" <%= todo.done ? 'checked' : '' %> disabled>
          <span><%= todo.title %></span>
        </li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
